  "venue": {
    "name": "ICC Sydney",
    "location": "SYD",
    "about": "Approximate model of ICC Sydney, from its public 'Entrance and venue levels' page: the Convention Centre (north, by Cockle Bay) holds the Grand Ballroom, Parkside Ballroom, Darling Harbour Theatre, Pyrmont Theatre, the Cockle Bay rooms and the meeting rooms; the Exhibition Centre (middle) has lower halls 1-4 and upper halls 5-7; the TikTok Entertainment Centre is at the southern end. Levels of C2.x, C3.x, C4.x and E5.x rooms come from the room codes; other levels are unverified, so an unknown level counts as a level change.",
    "zones": [
      { "pattern": "\\bc([2-4])\\.\\d", "building": "convention", "level": "$1", "zone": "Convention Centre rooms, level $1" },
      { "pattern": "^hall\\s*(1-4|[1-4])$", "building": "exhibition", "level": 0, "zone": "Exhibition halls 1 to 4 (lower)" },
      { "pattern": "^hall\\s*[5-7]$", "building": "exhibition", "level": 1, "zone": "Exhibition halls 5 to 7 (upper)" },
      { "pattern": "\\be5\\.", "building": "exhibition", "level": 5, "zone": "Exhibition Centre rooms, level 5" },
      { "pattern": "tiktok", "building": "tiktok", "level": 0, "zone": "TikTok Entertainment Centre" },
      { "pattern": "darling harbour theatre", "building": "convention", "level": null, "zone": "Darling Harbour Theatre" },
      { "pattern": "pyrmont theatre", "building": "convention", "level": null, "zone": "Pyrmont Theatre" },
      { "pattern": "grand (ballroom|br)\\b", "building": "convention", "level": null, "zone": "Grand Ballroom" },
      { "pattern": "parkside", "building": "convention", "level": null, "zone": "Parkside Ballroom" },
      { "pattern": "cockle bay", "building": "convention", "level": null, "zone": "Cockle Bay rooms" }
    ],
    "walkMinutes": { "convention|exhibition": 8, "exhibition|tiktok": 7, "convention|tiktok": 13 },
    "sameZoneMinutes": 2,
    "sameBuildingBaseMinutes": 3,
    "minutesPerLevel": 2,
    "unknownLevelChange": 1.5,
    "upstairsMinutes": 2
  },
  "source": {
    "type": "neurips-cc",
    "scheduleUrl": "https://neurips.cc/Conferences/2026/Schedule",
    "papersExportUrl": "https://neurips.cc/static/virtual/data/neurips-2026-orals-posters.json",
