      "titleKinds": ["Session", "Oral Session"],
      "venues": [
        { "location": "SYD", "pattern": "TikTok|Darling Harbour|Grand B|Parkside|Pyrmont|Cockle Bay|^Hall [1-5](-4)?$|^(MR |Room )?C\\d\\.\\d|^MR E\\d" },
        { "location": "PAR", "pattern": "Palais|Amphith|Paris|Sorbonne|Salle|^Room 15\\d" },
        { "location": "ATL", "pattern": "^Hall C\\d|^C\\d{3}" }
      ],
      "untimed": { "Oral": "SYD" },
      "untimedDefault": "TBA",
      "localHours": { "location": "SYD", "from": 7.5, "until": 19, "otherwise": "OTHER" }
    },
    "detailPages": {
